# ===========================================
# S1P Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Database (required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=s1p
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (required) ---
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256

# --- Application ---
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
TRUSTED_PROXY_HOSTS=127.0.0.1

# --- Email (SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=S1P CRM
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Webhook Security ---
WEBHOOK_IP_WHITELIST_ENABLED=true
SIPUNI_ALLOWED_IPS=
BINOTEL_ALLOWED_IPS=

# --- Recording Proxy ---
ALLOWED_RECORDING_HOSTS=

# --- Signed URLs ---
SIGNED_URL_SECRET=
SIGNED_URL_EXPIRY=86400

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=s1pcrm_bot
TELEGRAM_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_DIGEST_HOUR=9
TELEGRAM_DIGEST_MINUTE=0

# --- Pyrogram Userbot (MTProto) ---
PYROGRAM_API_ID=0
PYROGRAM_API_HASH=
PYROGRAM_SESSION_STRING=
PYROGRAM_ENABLED=false
