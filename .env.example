# ===========================================
# S1P Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.

# --- Database (required) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=s1p
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (required) ---
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256

# --- Application ---
BASE_URL=http://localhost:8000

# --- Email (SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=S1P CRM
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Webhook Security ---
WEBHOOK_IP_WHITELIST_ENABLED=true
SIPUNI_ALLOWED_IPS=
BINOTEL_ALLOWED_IPS=

# --- Recording Proxy ---
ALLOWED_RECORDING_HOSTS=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
