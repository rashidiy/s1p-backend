# ===========================================
# S1P Docker Environment Configuration
# ===========================================
# Copy this file to .env and modify as needed
# docker-compose will read from .env by default

# ===========================================
# Application Settings
# ===========================================
APP_PORT=8000
BASE_URL=http://localhost:8000

# ===========================================
# PostgreSQL Database
# ===========================================
POSTGRES_DB=sip_tools
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_change_me
# External port for direct DB access (optional)
POSTGRES_EXTERNAL_PORT=5433

# ===========================================
# Redis Cache
# ===========================================
# External port for direct Redis access (optional)
REDIS_EXTERNAL_PORT=6379

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Change this in production!
JWT_SIGNING_KEY=your-super-secret-jwt-key-min-32-chars-long-change-in-production
JWT_ALGORITHM=HS256

# ===========================================
# Webhook Security
# ===========================================
# Enable IP whitelisting for webhooks
WEBHOOK_IP_WHITELIST_ENABLED=false

# Allowed IPs for Sipuni webhooks (semicolon-separated)
SIPUNI_ALLOWED_IPS=127.0.0.1;10.0.0.1;213.230.72.24;193.227.98.1;193.227.98.2;193.227.98.3;193.227.98.4;193.227.98.5;193.227.98.21;212.193.100.1;212.193.100.2;212.193.100.21;195.19.13.1;195.19.13.2;195.19.13.3;195.19.13.4;195.19.13.5;195.19.13.9

# Allowed IPs for Binotel webhooks (semicolon-separated)
BINOTEL_ALLOWED_IPS=

# ===========================================
# Development Tools (Optional)
# ===========================================
# PgAdmin credentials
PGADMIN_EMAIL=admin@s1p.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Redis Commander port
REDIS_COMMANDER_PORT=8081
